import { run } from './orm';
import { User } from './entities/User';

// ===== BAI 10C — QB tra ve entity: getResultList() =====
// DOAN KET QUA TRUOC KHI CHAY.

run(async (em) => {

  const users = await em.createQueryBuilder(User, 'u')
    .where({ name: 'Than' })
    .getResultList();

  const u = users[0];
  console.log('u la User?', u instanceof User);

  u.name = 'Ten moi';
  console.log('--- SAP FLUSH ---');
  await em.flush();
  console.log('--- FLUSH XONG ---');

});

/* KET QUA: u la User? true. Flush: begin / update user set name = 'Ten moi' where id = 1 / commit.
   getResultList() tra ve entity that -> vao so, co anh chup goc -> flush thay thay doi. */
