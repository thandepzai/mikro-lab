//    - Ca 4 lan xem (0 -> 3) deu con du 3 dong: But/Viet xanh, Vo/100 trang, Thuoc/30cm
//    - So: chua co so -> [file] -> [] -> [file]
// ================================================================
async function nv3Tao() {
  const file = db('nv3');
  xoaThuMuc('nv3');
  await taoDBCu(file, true);
  const orm = await moORM(SanPhamDoi2, file, 'nv3');

  // TODO

  await orm.close(true);
}

// TODO: viet ham nay, NV6 dung lai.
//   xem '0. Ban dau' -> up() -> xem '1. Sau up()' -> down() -> xem '2. Sau down()' -> up() -> xem '3. Sau up() lan 2'
//   Moi up()/down() boc try/catch rieng: loi thi in 'LOI:' + message roi VAN chay tiep buoc sau.
async function vongTron(orm: ORM) {
  // TODO
}

async function nv3Chay() {
  const file = db('nv3');
  await taoDBCu(file, true);
  const orm = await moORM(SanPhamDoi2, file, 'nv3');
  await vongTron(orm);
  await orm.close(true);
}

// ================================================================
//  NHIEM VU 4 — snapshot                                      (on 18F)
//  Buoc a: npm run dev -- nv4
//    DB la ':memory:' -> moi buoi mo ORM la mot DB TRONG TRON. Khong up() giua cac buoi.
//    TODO trong ham buoi(): mo ORM (thuMuc 'nv4', debug true) -> create()
//          -> in fileName (khong co thi in '(khong sinh file)') va diff.up -> close.
//    DU DOAN:
//      SANG  (id, ten)     sinh: ->
//      CHIEU them gia      sinh: ->   (DB van trong, vay co create table khong?)
//      TOI   khong sua gi  sinh: ->
//      Buoi nao co cau query doc DB (sqlite_master, pragma)? ->
//    CAU HOI: neu xoa src/bt18/nv4/.snapshot-memory.json truoc buoi CHIEU,
//             CHIEU sinh gi? Deploy 2 file do len DB trong thi sao? ->
//  Buoc b: npm run dev -- nv4-deploy
//    TODO trong nv4Deploy: in ten cac file pending -> up() (try/catch) -> xem.
//    YEU CAU: pending 2 file, up() chay ca 2, cot: id, ten, gia.
// ================================================================
async function nv4() {
  xoaThuMuc('nv4');
  const buoi = async (nhan: string, entity: EntityClass<object>) => {
    console.log(`\n========== ${nhan} ==========`);

    // TODO

    await doi1Giay();
  };
  await buoi('SANG: (id, ten)', SanPhamV1);
  await buoi('CHIEU: them gia', SanPhamV2);
  await buoi('TOI: khong sua gi', SanPhamV2);
}

async function nv4Deploy() {
  const orm = await moORM(SanPhamV2, ':memory:', 'nv4');

  // TODO

  await orm.close(true);
}

// ================================================================
//  NHIEM VU 5 — Server NestJS tu up() luc khoi dong          (on 18G)
//  Dung lai 2 file migration cua NV4. DB server: db-bt18/server.sqlite, GIU LAI giua cac lan chay.
//  TODO trong nv5: tao app (logger chi 'error') -> in pending -> up() o DUNG CHO -> in ten file vua chay
//        -> listen 3000 -> fetch GET http://localhost:3000/san-pham/them -> in status + body -> close app.
//  Chay 3 lan, moi lan DU DOAN truoc (pending / up() chay file nao / tra ve gi):
//    Lan 1: npm run dev -- nv5 moi   (xoa DB, server moi tinh)  ->
//    Lan 2: npm run dev -- nv5       (khoi dong lai, giu DB)     ->
//    Lan 3: comment dong up() lai, npm run dev -- nv5 moi
//           Loi gi? Khac loi o 18G cho nao? Vi sao? ->
//  Xong nho bo comment dong up().
// ================================================================
@Controller('san-pham')
class SanPhamController {
  constructor(private readonly em: EntityManager) {}

  @Get('them')
  async them() {
    this.em.create(SanPhamV2, { ten: 'But', gia: 5000 });
    await this.em.flush();
    return this.em.find(SanPhamV2, {});
  }
}

@Module({
  imports: [
    MikroOrmModule.forRoot({
      driver: SqliteDriver,
      entities: [SanPhamV2],
      dbName: db('server'),
      metadataProvider: ReflectMetadataProvider,
      extensions: [Migrator],
      migrations: { path: 'dist/bt18/nv4', pathTs: 'src/bt18/nv4' },
    }),
  ],
  controllers: [SanPhamController],
})
class AppModule {}

async function nv5(moi: boolean) {
  if (moi) rmSync(db('server'), { force: true });

  // TODO
}

// ================================================================
//  NHIEM VU 6 — Review file cua dong nghiep                   (on toan bo bai 18)
//  Dong nghiep sua entity thanh SanPhamNV6 (ten -> tenSp, moTa -> ghiChu, them gia bat buoc)
//  va tu viet tay file src/bt18/nv6/Migration20261021120000.ts, nho ban review truoc khi merge.
//  DB server hien tai: san_pham(id, ten, mo_ta), 3 dong.
//  Buoc a: CHI DOC file, CHUA chay. File co 3 loi, ghi ra:
//    1. ->
//    2. ->
//    3. ->
//  Buoc b: npm run dev -- nv6   (dung lai vongTron cua NV3). Log co khop voi 3 loi ban ghi khong?
//  Buoc c: sua file den khi pass.
//    Luu y: up() loi giua chung thi ca file bi huy (rollback), nen co the phai sua xong loi nay moi lo ra loi sau.
//  YEU CAU cuoi:
//    - Ca 4 lan xem deu con du 3 dong, khong mat mo ta (Viet xanh, 100 trang, 30cm)
//    - Sau up(): cot id, ten_sp, ghi_chu, gia | Sau down(): ve dung id, ten, mo_ta
//    - Khong co dong LOI nao
// ================================================================
async function nv6() {
  const file = db('nv6');
  await taoDBCu(file, true);
  const orm = await moORM(SanPhamNV6, file, 'nv6');
  await vongTron(orm);
  await orm.close(true);
}

const [lenh, thamSo] = process.argv.slice(2);
const bang: Record<string, () => Promise<void>> = {
  nv1,
  nv2,
  'nv3-tao': nv3Tao,
  'nv3-chay': nv3Chay,
  nv4,
  'nv4-deploy': nv4Deploy,
  nv5: () => nv5(thamSo === 'moi'),
  nv6,
};
const chay = bang[lenh];
if (chay) chay();
else console.log('Chay: npm run dev -- <lenh>. Lenh:', Object.keys(bang).join(' | '));
