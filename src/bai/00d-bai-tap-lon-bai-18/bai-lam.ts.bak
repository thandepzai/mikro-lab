// ================================================================
//  BAI TAP LON — ON TAP BAI 18: MIGRATION
//  Lam TUNG nhiem vu mot. Xong nhiem vu nao -> gui log cho Claude cham.
//  Chay: npm run dev -- <lenh>   (vd: npm run dev -- nv1)
//    -> luon compile truoc khi chay. Bat buoc, vi migrator.up() doc file trong dist/.
//  Can Node 22: nvm use
//  Bang dung chung: san_pham. Moi nhiem vu co DB rieng trong thu muc db-bt18/.
//  Ham co san (khong can sua): db(), moORM(), taoDBCu(), xem(), xoaThuMuc(), doi1Giay().
// ================================================================
import 'reflect-metadata';
import { mkdirSync, rmSync } from 'node:fs';
import { Controller, Get, Module } from '@nestjs/common';
import { NestFactory } from '@nestjs/core';
import { MikroOrmModule } from '@mikro-orm/nestjs';
import { MikroORM, EntityManager, SqliteDriver, EntityClass } from '@mikro-orm/sqlite';
import { Migrator } from '@mikro-orm/migrations';
import { Entity, PrimaryKey, Property, ReflectMetadataProvider } from '@mikro-orm/decorators/legacy';

@Entity({ tableName: 'san_pham' })
class SanPhamNV1 {
  @PrimaryKey()
  id!: number;

  @Property({ nullable: true })
  ten?: string;

  @Property()
  gia!: number;
}

@Entity({ tableName: 'san_pham' })
class SanPhamDoi1 {
  @PrimaryKey()
  id!: number;

  @Property({ nullable: true })
  tenSp?: string;

  @Property({ nullable: true })
  moTa?: string;
}

@Entity({ tableName: 'san_pham' })
class SanPhamDoi2 {
  @PrimaryKey()
  id!: number;

  @Property({ nullable: true })
  tenSp?: string;

  @Property({ nullable: true })
  ghiChu?: string;
}

@Entity({ tableName: 'san_pham' })
class SanPhamV1 {
  @PrimaryKey()
  id!: number;

  @Property({ nullable: true })
  ten?: string;
}

@Entity({ tableName: 'san_pham' })
class SanPhamV2 {
  @PrimaryKey()
  id!: number;

  @Property({ nullable: true })
  ten?: string;

  @Property({ nullable: true })
  gia?: number;
}

@Entity({ tableName: 'san_pham' })
class SanPhamNV6 {
  @PrimaryKey()
  id!: number;

  @Property({ nullable: true })
  tenSp?: string;

  @Property({ nullable: true })
  ghiChu?: string;

  @Property({ default: 0 })
  gia!: number;
}

// ================= HAM CO SAN =================
mkdirSync('db-bt18', { recursive: true });
const db = (ten: string) => `db-bt18/${ten}.sqlite`;

// thuMuc: file migration nam o src/bt18/<thuMuc>, ban da compile o dist/bt18/<thuMuc>
// debug = true: in ra moi cau query ORM gui xuong DB
const moORM = (entity: EntityClass<object>, dbName: string, thuMuc = 'chung', debug = false) =>
  MikroORM.init({
    entities: [entity],
    dbName,
    metadataProvider: ReflectMetadataProvider,
    extensions: [Migrator],
    migrations: { path: `dist/bt18/${thuMuc}`, pathTs: `src/bt18/${thuMuc}` },
    debug: debug ? ['query'] : false,
  });

type ORM = Awaited<ReturnType<typeof moORM>>;

const xoaThuMuc = (thuMuc: string) => {
  rmSync(`src/bt18/${thuMuc}`, { recursive: true, force: true });
  rmSync(`dist/bt18/${thuMuc}`, { recursive: true, force: true });
};

const doi1Giay = () => new Promise(r => setTimeout(r, 1100));

// Xoa DB cu, tao lai bang san_pham co 3 dong:
//   coMoTa = false -> (id, ten)         : But, Vo, Thuoc
//   coMoTa = true  -> (id, ten, mo_ta)  : But/Viet xanh, Vo/100 trang, Thuoc/30cm
async function taoDBCu(dbName: string, coMoTa: boolean) {
  rmSync(dbName, { force: true });
  const orm = await moORM(SanPhamV1, dbName);
  const conn = orm.em.getConnection();
  if (coMoTa) {
    await conn.execute('create table `san_pham` (`id` integer not null primary key autoincrement, `ten` text null, `mo_ta` text null)');
    await conn.execute("insert into `san_pham` (`ten`, `mo_ta`) values ('But', 'Viet xanh'), ('Vo', '100 trang'), ('Thuoc', '30cm')");
  } else {
    await conn.execute('create table `san_pham` (`id` integer not null primary key autoincrement, `ten` text null)');
    await conn.execute("insert into `san_pham` (`ten`) values ('But'), ('Vo'), ('Thuoc')");
  }
  await orm.close(true);
}

// In ra: cac cot cua san_pham, cac dong du lieu, so mikro_orm_migrations
async function xem(orm: ORM, nhan: string) {
  const conn = orm.em.getConnection();
  const cot = ((await conn.execute('pragma table_info(san_pham)')) as { name: string }[]).map(c => c.name);
  const dong = cot.length ? await conn.execute('select * from `san_pham`') : [];
  let so: string[] | string = 'chua co so';
  try {
    so = ((await conn.execute('select `name` from `mikro_orm_migrations`')) as { name: string }[]).map(r => r.name);
  } catch {}
  console.log(`\n--- ${nhan} ---`);
  console.log('Cot :', cot);
  console.log('Dong:', dong);
  console.log('So  :', so);
}

// ================================================================
//  NHIEM VU 1 — schema.update() va du lieu cu                 (on 18A)
//  Lenh: npm run dev -- nv1
//  DB cu: san_pham(id, ten), 3 dong. Entity SanPhamNV1 them `gia` bat buoc, chua co default.
//  TODO: in ra SQL ORM dinh chay (CHUA chay that).
//        Roi chay that bang schema.update(), boc try/catch, loi thi in message.
//  DU DOAN (viet truoc khi chay):
//    Cau SQL se la: ->
//    Chay that thi: ->
//  Thay loi roi thi sua entity SanPhamNV1 (CHI sua decorator) cho chay duoc, chay lai.
//  YEU CAU cuoi: khong con LOI, ca 3 dong deu co gia = 0.
//  CAU HOI: neu bang san_pham dang TRONG (0 dong) thi cau SQL ban dau co bi loi khong? ->
// ================================================================
async function nv1() {
  const file = db('nv1');
  await taoDBCu(file, false);
  const orm = await moORM(SanPhamNV1, file);

  // TODO

  await xem(orm, 'Sau schema.update()');
  await orm.close(true);
}

