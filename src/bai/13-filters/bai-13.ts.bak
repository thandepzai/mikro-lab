import { run } from "./orm";
import { Post } from "./entities/Post";

run(async (em) => {
  console.log("===== THI NGHIEM 1: FILTER CO DINH =====");
  em.addFilter({ name: "chiCuaThan", cond: { author: 1 }, entity: [Post] });
  const coFilter = await em.find(Post, {});
  console.log(coFilter.map((p) => p.title)); // co filter: 1 bai
  const khongFilter = await em.find(Post, {}, { filters: false });
  console.log(khongFilter.map((p) => p.title)); // filters:false: 3 bai
});

// ===== KET QUA THI NGHIEM 1 =====
// em.addFilter({ name, cond, entity }) -- KHONG phai 3 tham so roi,
// ma 1 object duy nhat. cond la dieu kien se tu dong cheng vao
// WHERE cua MOI find/findOne cho entity do. default enabled = true
// (khong can khai bao). Muon tat tam thoi: { filters: false }.

