import { run } from "./orm";
import { Post } from "./entities/Post";
import { User } from "./entities/User";

run(async (em) => {
  console.log("===== THI NGHIEM 1: INSERT LONG NHAU =====");
  em.create(Post, {
    title: "Bai co tac gia moi",
    author: { name: "Tac Gia Moi", email: "tacgia@example.com" },
  } as any);
  await em.flush();
});

// ===== KET QUA THI NGHIEM 1 =====
// Code viet Post truoc, User (author) long ben trong.
// Nhung insert into "user" CHAY TRUOC insert into "post".
// Ly do: post.author_id la khoa ngoai tro toi user.id, user chua co id
// cho toi khi duoc insert. MikroORM tu dung "do thi phu thuoc" giua
// cac entity dang cho flush, roi sap: entity bi tham chieu insert truoc,
// entity tham chieu toi no insert sau -- khong quan tam thu tu goi
// em.create() trong code.

