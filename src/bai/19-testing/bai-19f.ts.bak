// BAI 19F — Service NestJS inject em: lam sao de rollback cuu duoc?
// DOAN TRUOC KHI CHAY: voi C, D, E dong "count sau rollback" in 3 hay 4 (hay bao loi)? ->
import "reflect-metadata";
import { Injectable, Module } from "@nestjs/common";
import { NestFactory } from "@nestjs/core";
import { MikroOrmModule } from "@mikro-orm/nestjs";
import { MikroORM, EntityManager, SqliteDriver } from "@mikro-orm/sqlite";
import { RequestContext } from "@mikro-orm/core";
import type { EntityManager as CoreEntityManager } from "@mikro-orm/core";
import { ReflectMetadataProvider } from "@mikro-orm/decorators/legacy";
import { User } from "./entities/User";
import { Post } from "./entities/Post";
import { Comment } from "./entities/Comment";
import { taoBangVaSeed } from "./orm";

@Injectable()
class UserService {
  constructor(private readonly em: EntityManager) {}

  async taoMoi() {
    this.em.create(User, { name: "Moi", email: "moi@example.com" });
    await this.em.flush();
  }
}

@Module({
  imports: [
    MikroOrmModule.forRoot({
      driver: SqliteDriver,
      entities: [User, Post, Comment],
      dbName: ":memory:",
      metadataProvider: ReflectMetadataProvider,
    }),
  ],
  providers: [UserService],
})
class AppModule {}

async function main() {
  const app = await NestFactory.createApplicationContext(AppModule, { logger: ["error"] });
  const orm = app.get(MikroORM);
  await taoBangVaSeed(orm);
  orm.config.set("debug", ["query"]);
  const service = app.get(UserService);
  const troiSau2s = new Promise<never>((_, rj) => setTimeout(() => rj(new Error("KET (timeout 2s)")), 2000));

  console.log("\n===== C: goi service lay tu app.get, khong boc gi =====");
  await service.taoMoi().catch((e) => console.log("LOI:", (e as Error).message.slice(0, 60)));

  console.log("\n===== D: new UserService(em cua test) =====");
  const emD = orm.em.fork();
  await emD.begin();
  await new UserService(emD).taoMoi();
  console.log("count trong test:", await emD.count(User));
  await emD.rollback();
  console.log("count sau rollback:", await orm.em.fork().count(User));

  console.log("\n===== E: service tu app.get, boc RequestContext.create(em cua test) =====");
  const emE = orm.em.fork();
  await emE.begin();
  await Promise.race([
    RequestContext.create(emE as unknown as CoreEntityManager, () => service.taoMoi()),
    troiSau2s,
  ]).catch((e) => console.log("LOI:", (e as Error).message));
  console.log("count trong test:", await emE.count(User));
  await emE.rollback();
  console.log("count sau rollback:", await orm.em.fork().count(User));
  await app.close();
}
main();
