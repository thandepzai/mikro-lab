import {
  Entity,
  PrimaryKey,
  Property,
  ManyToOne,
  BeforeCreate,
  BeforeUpdate,
} from "@mikro-orm/decorators/legacy";
import { Post } from "./Post";

@Entity()
export class Comment {
  @PrimaryKey()
  id!: number;

  @Property()
  title!: string;

  @ManyToOne(() => Post)
  post!: Post;

  @Property({ nullable: true })
  createdAt?: Date;

  @Property({ nullable: true })
  updatedAt?: Date;

  @BeforeCreate()
  ganCreatedAt() {
    console.log("--- HOOK @BeforeCreate CHAY ---");
    this.createdAt = new Date();
  }

  @BeforeUpdate()
  ganUpdatedAt() {
    console.log("--- HOOK @BeforeUpdate CHAY ---");
    this.updatedAt = new Date();
  }
}
