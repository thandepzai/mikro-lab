import { run } from './orm';
import { Post } from './entities/Post';

// ===== BAI 7A — Ref: bat TypeScript chan cai vo =====
// DOAN KET QUA TRUOC KHI CHAY.

run(async (em) => {

  const post = await em.findOne(Post, 1);

  console.log('author.id   =', post!.author.id);
  console.log('author.name =', post!.author.name);

});

