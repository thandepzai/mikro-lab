import { RequestContext } from '@mikro-orm/core';
import { run } from './orm';
import { User } from './entities/User';

// ===== BAI 3B - RequestContext =====
// Y HET bai 3A. Chi khac: ca hai request deu dung `orm.em` - MOT bien duy nhat,
// dung y nhu NestJS inject vao service. Va boc trong RequestContext.

run(async (em, orm) => {

  let a!: User;

    a = (await orm.em.findOne(User, 1))!;
    a.name = 'A dang sua, CHUA luu';

    const b = await orm.em.findOne(User, 1);
    console.log('>> B nhin thay :', b!.name);
    console.log('>> a === b ?   ', a === b);
    await orm.em.flush();

  // --- Bai tap A: xoa hai lop RequestContext.create di, goi orm.em truc tiep.
  //     Doc ky message loi.

});

// KET QUA: giong het em.fork(). RequestContext.create = fork() + AsyncLocalStorage.
//
// Bai tap A - bo RequestContext di, goi orm.em tran:
//   ValidationError: Using global EntityManager instance methods for context specific
//   actions is disallowed. If you need to work with the global instance's identity map,
//   use `allowGlobalContext` configuration option or `fork()` instead.
//
//   -> allowGlobalContext: true la BAY. Het loi nhung bug ro du lieu quay lai nguyen ven.
