import { run, trangThai } from './orm';
import { User } from './entities/User';

// ===== BAI 4C - detached van con id =====
// Y het 4B, chi noi them 3 dong o cuoi.

run(async (em) => {

  const u = (await em.findOne(User, 1))!;
  em.remove(u);
  await em.flush();
  console.log('   trang thai:', trangThai(em, u), '| u.id =', u.id, '| u.name =', u.name);

  console.log('\n--- SAP GOI em.persist() lan nua ---');
  em.persist(u);
  await em.flush();
  console.log('--- XONG ---');
  console.log('   trang thai:', trangThai(em, u), '| u.id =', u.id);

  // --- Bai tap A: doi dong em.persist(u) thanh 2 dong nay:
  //         em.merge(u);
  //         u.name = 'Doi sau merge';
  //     Doc ky cau SQL sinh ra, KE CA phan trong ngoac vuong o cuoi dong.

});

// KET QUA:
//   DETACHED (vao bang remove+flush, row da xoa) -> persist() -> flush()
//     insert into `user` (`id`, `name`, `email`) values (1, ...)   <- CO cot id, do u.id quyet
//
//   Bai tap A (merge, row da bi xoa):
//     update `user` set `name` = 'Doi sau merge' where `id` = 1  [0 rows affected]
//     -> khong exception, khong canh bao. Cau update roi vao khoang khong.
//
// HAI LOAI DETACHED, persist() xu ly khac nhau:
//   vao bang remove()+flush() (row da xoa)  -> persist = insert kem id cu
//   vao bang em.clear()       (row van con) -> persist KHONG BAO GIO insert.
//
// Anh chup goc nam tren chinh object entity, khong phai chi trong em.
// em.clear() khong dung toi no -> object van tu mang co "tao tu DB ra, tao khong moi".
// Ca 3 kich ban duoi day deu 0 cau select. Khong he hoi DB.
//
//   clear -> persist -> flush (chua sua gi)  : khong SQL | DETACHED, sua sau do cung vo hieu
//   clear -> sua -> persist -> flush         : update [1] | DETACHED, ghi 1 phat roi buong
//   clear -> merge -> sua -> flush           : update [1] | MANAGED, quan lai that su
//
// => persist tren detached la phat mot lan. merge moi la gan lai.
