{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": true,
    "baseUrl": "./src",
    "paths": {
      "@module/*": ["module/*"],
      "@base/*": ["base/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/bai"]
}
